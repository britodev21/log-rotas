# Configuração da instalação em produção (docker compose).
#
# Copie para `.env` na VPS e preencha. O `.env` NUNCA vai para o
# repositório — ele é público, e aqui há senha e chave paga.
#
#   cp .env.example .env && nano .env
#
# Segredo bom é o que ninguém escolheu: gere com
#   openssl rand -base64 36

# --- Endereço -------------------------------------------------------------
# O domínio que o Traefik vai atender. Precisa já apontar para o IP da VPS.
DOMINIO=log-rotas.suaempresa.com.br

# Rede por onde o Traefik fala com a tela. Com o Traefik em modo `host` (o
# caso do template Docker+Traefik da Hostinger), é a própria rede deste
# projeto — deixe como está. Se o seu Traefik roda numa rede própria,
# descubra o nome com `docker network ls`, ponha aqui, e acrescente essa
# rede como externa no docker-compose.yml.
REDE_TRAEFIK=log-rotas-interna
# Nomes usados na configuração do seu Traefik (os padrões abaixo são os mais
# comuns). Confira com: docker inspect traefik | grep -i entrypoint
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Banco ----------------------------------------------------------------
POSTGRES_USER=logrotas
POSTGRES_PASSWORD=
POSTGRES_DB=log_rotas

# --- Sessão ---------------------------------------------------------------
# Trocar esta chave desconecta todo mundo. Nunca reaproveite a do
# desenvolvimento.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Segurança ------------------------------------------------------------
# Só com HTTPS funcionando — é o caso aqui, o Traefik cuida disso.
HSTS=true
LOGIN_MAX_FALHAS_CONTA=5
LOGIN_MAX_FALHAS_IP=20
LOGIN_JANELA_MINUTOS=15
LOGIN_BLOQUEIO_MINUTOS=15

# --- Operação -------------------------------------------------------------
TZ=America/Campo_Grande
DEFAULT_TIMEZONE=America/Campo_Grande
# Hora local da limpeza automática; -1 desliga.
LIMPEZA_HORA=3
RETENCAO_POSICOES_DIAS=90
RETENCAO_TENTATIVAS_LOGIN_DIAS=180
RETENCAO_EVENTOS_SEGURANCA_DIAS=730

# --- Serviços externos ----------------------------------------------------
# Chave do Google (Places, Routes). NA VPS, restrinja a chave por IP do
# servidor — é o que impede alguém de gastar a sua cota se ela vazar.
GOOGLE_MAPS_API_KEY=
# "google" liga o trânsito no planejamento e na previsão de chegada.
TRAFFIC_PROVIDER=google
TRAFFIC_REFRESH_S=300
TRAFFIC_MAX_CONSULTAS_PLANO=40

MATRIX_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# --- Desempenho -----------------------------------------------------------
# Processos da API. 2 dá conta de uma operação deste tamanho com folga.
WORKERS=2
LOG_LEVEL=info
