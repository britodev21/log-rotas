# =============================================================
# LOG ROTAS — exemplo de configuracao
# Copie para .env e ajuste. O .env NUNCA vai para o git.
# =============================================================

APP_NAME="Log Rotas"
ENVIRONMENT=development
DEBUG=true

# --- Banco de dados ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/log_rotas

# --- Seguranca ---
# Gere um valor proprio com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor-antes-de-usar-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: origens do frontend, separadas por virgula ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Operacao ---
DEFAULT_TIMEZONE=America/Campo_Grande
# Tempo padrao de permanencia numa parada, em minutos.
# Calibrar com dados reais da operacao (ver docs/LIMITACOES.md).
DEFAULT_STOP_SERVICE_MINUTES=60

# --- Provedores externos (Fases 4 e 5 — ainda nao utilizados) ---
# nominatim | google | here
#
# O nominatim e gratuito e NAO acha o numero da porta em Campo Grande: o
# OpenStreetMap tem numero em cerca de 530 predios da cidade, e em oito
# enderecos reais das avenidas principais ele acertou o numero em zero.
# Na pratica isso significa confirmar o ponto no mapa em quase todo
# endereco novo (uma vez por endereco — cliente cadastrado propaga).
#
# google e here mantem base propria de enderecos e resolvem no numero,
# dispensando a confirmacao na maioria dos casos. Ambos exigem chave em
# GEOCODING_PROVIDER_KEY. Nenhuma outra linha do sistema muda.
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Obrigatorio pela politica de uso do Nominatim: identifique a aplicacao.
NOMINATIM_USER_AGENT=LogRotas/0.1 (contato@logrotas.com)
# Obrigatoria para google e here. Ignorada pelo nominatim.
GEOCODING_PROVIDER_KEY=

# Google Maps Platform. Liga a busca de endereco com sugestoes (Places
# Autocomplete) no cadastro — o campo "tal qual o Google Maps". Vazia, a
# tela usa o fluxo por CEP.
#
# No console do Google, ative:
#   - Places API (New)   obrigatoria: sugestoes e detalhe do lugar
#   - Geocoding API      recomendada, EXIGE FATURAMENTO: diz se o ponto e o telhado
#                        (ROOFTOP). Sem ela, todo endereco escolhido pede um
#                        clique de conferencia no mapa.
# Restrinja a chave a essas duas APIs. A chamada sai do servidor; a chave
# nunca vai para o navegador. NUNCA faca commit do .env: o repo e publico.
GOOGLE_MAPS_API_KEY=

MATRIX_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
MAP_PROVIDER_KEY=
